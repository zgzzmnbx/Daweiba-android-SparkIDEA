# Copy to /etc/dabawei-cloud-reminder.env on the server and chmod 0600.
CLOUD_REMINDER_API_TOKEN=replace-with-a-random-device-token
CLOUD_REMINDER_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/replace-me
CLOUD_REMINDER_CERT_FILE=/etc/dabawei-cloud-reminder/server.crt
CLOUD_REMINDER_KEY_FILE=/etc/dabawei-cloud-reminder/server.key
CLOUD_REMINDER_DB=/var/lib/dabawei-cloud-reminder/reminders.sqlite3
CLOUD_REMINDER_HOST=0.0.0.0
CLOUD_REMINDER_PORT=1291
