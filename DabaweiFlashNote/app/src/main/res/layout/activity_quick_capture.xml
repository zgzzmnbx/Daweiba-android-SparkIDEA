<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quickRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/quickTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/quick_capture_title"
        android:textColor="@color/foreground"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/quickSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/quick_capture_subtitle"
        android:textColor="@color/muted_foreground"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/quickNoteInput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:background="@drawable/input_background"
        android:gravity="top|start"
        android:hint="@string/note_hint"
        android:imeOptions="flagNoExtractUi"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="5"
        android:padding="14dp"
        android:textColor="@color/foreground"
        android:textColorHint="@color/muted_foreground"
        android:textSize="17sp" />

    <Button
        android:id="@+id/quickSaveButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:minHeight="48dp"
        android:text="@string/save_note"
        android:textColor="@color/primary_foreground"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
